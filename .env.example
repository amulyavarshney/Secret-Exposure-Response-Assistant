# Copy to .env.local (web) or export in your shell. Never commit real values.

# Optional: stable HMAC salt for fingerprint correlation across runs
SECRET_RESPONSE_FINGERPRINT_SALT=

# Optional: CLI sanitized session path (default under ~/.secret-response/)
SECRET_RESPONSE_SESSION_PATH=

# --- Jira (optional) ---
SECRET_RESPONSE_JIRA_BASE_URL=https://your-org.atlassian.net
SECRET_RESPONSE_JIRA_EMAIL=security-bot@example.com
SECRET_RESPONSE_JIRA_API_TOKEN=
SECRET_RESPONSE_JIRA_PROJECT_KEY=SEC
# SECRET_RESPONSE_JIRA_ISSUE_TYPE=Task
# SECRET_RESPONSE_JIRA_ASSIGNEE=

# --- ServiceNow (optional) ---
# SECRET_RESPONSE_SERVICENOW_INSTANCE_URL=https://instance.service-now.com
# SECRET_RESPONSE_SERVICENOW_USERNAME=
# SECRET_RESPONSE_SERVICENOW_PASSWORD=
# SECRET_RESPONSE_SERVICENOW_ASSIGNMENT_GROUP=
# SECRET_RESPONSE_SERVICENOW_CALLER_ID=

# --- Slack (optional) ---
# SECRET_RESPONSE_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# --- PagerDuty (optional; Critical/High only) ---
# SECRET_RESPONSE_PAGERDUTY_ROUTING_KEY=
